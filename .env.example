PORT=3000
# Public server address (no domain — use IP)
PUBLIC_BASE_URL=http://173.242.59.183:3000
NODE_ENV=development

# --- Poster ---
# Application Id from Poster developer cabinet (Integration_NPS = 5178)
POSTER_APPLICATION_ID=5178
# Application secret from Poster developer cabinet (for webhook signature + OAuth)
POSTER_APPLICATION_SECRET=your_poster_app_secret
# Access token (optional if you use /poster-connect OAuth — saved to SQLite)
POSTER_ACCESS_TOKEN=
# Optional: account name filter, e.g. my-cafe
POSTER_ACCOUNT=
# Comma-separated statuses that trigger NPS (codes and/or names)
POSTER_TRIGGER_STATUSES=delivered,completed,доставлено,завершено,closed,10
# Comma-separated statuses that cancel a pending NPS
POSTER_CANCEL_STATUSES=cancelled,canceled,returned,rejected,скасовано,повернено,відмінено,відхилено,anulowano,7,8,9
# Initial delay before sending NPS (ms). Default 2 hours. Editable later in /admin.
NPS_DELAY_MS=7200000
# Quiet hours: do not send NPS at night (editable in /admin)
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=00:00
QUIET_HOURS_END=09:00
TIMEZONE=Europe/Kyiv
# Admin panel login: http://IP:3000/admin
ADMIN_USER=admin
ADMIN_PASSWORD=NpsAdmin2026
SESSION_SECRET=change-me-session-secret
# API key for /admin/simulate and JSON endpoints
TEST_API_KEY=dev-test-key

# --- SendPulse ---
# Mode: automation360 | sms | dry-run
SENDPULSE_MODE=automation360
# Automation 360 event URL (POST without auth), from Events Manager
SENDPULSE_EVENT_URL=
# Optional automation flow id
SENDPULSE_AUTOMATION_ID=
# Direct SMS API (used when SENDPULSE_MODE=sms)
SENDPULSE_API_ID=
SENDPULSE_API_SECRET=
SENDPULSE_SMS_SENDER=YourBrand
# NPS text for direct SMS mode. Variables: {{name}}, {{order_id}}, {{phone}}
NPS_SMS_TEMPLATE=Дякуємо за замовлення #{{order_id}}! Оцініть нас від 0 до 10 у відповідь на це SMS.

# --- Storage / logs ---
DATABASE_PATH=./data/nps.sqlite
LOG_LEVEL=info
